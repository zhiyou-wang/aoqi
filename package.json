{
  "name": "aoqi",
  "version": "0.1.0",
  "private": true,
  "description": "奥奇传说精灵图鉴与养成系统（monorepo）",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @aoqi/web",
    "build:web": "npm run build --workspace @aoqi/web",
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload --port 8000"
  },
  "engines": {
    "node": ">=20"
  }
}
