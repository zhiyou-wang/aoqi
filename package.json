{
  "name": "aoqi",
  "version": "0.1.0",
  "private": true,
  "description": "奥奇传说精灵图鉴与养成系统（前后端分离）",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @aoqi/web",
