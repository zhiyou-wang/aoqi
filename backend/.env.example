# 奥奇 API 环境配置示例
# 复制为 .env 并填入真实值

# 应用
APP_NAME=奥奇传说图鉴 API
APP_ENV=dev
APP_DEBUG=true

# Oracle 数据库
# 当前使用 SCOTT schema（生产环境应改为独立 schema）
DB_USER=scott
DB_PASSWORD=123456
DB_DSN=localhost:1521/orclpdb
DB_SCHEMA=SCOTT

# CORS（前端 dev 地址）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
